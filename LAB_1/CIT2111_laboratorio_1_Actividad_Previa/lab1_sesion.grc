- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Sampler',\n            in_sig=[np.float32, np.float32],\n\
      \            out_sig=[np.float32]\n        )\n        self.held_value = 0.0\n\
      \        self.last_ctrl = 0.0\n\n    def work(self, input_items, output_items):\n\
      \        in_data = input_items[0]\n        in_ctrl = input_items[1]\n      \
      \  out = output_items[0]\n\n        for i in range(len(out)):\n            #\
      \ Detecta el flanco de subida de la se\xF1al cuadrada para tomar una nueva muestra\n\
      \            if in_ctrl[i] > 0 and self.last_ctrl <= 0:\n                self.held_value\
      \ = in_data[i]\n            self.last_ctrl = in_ctrl[i]\n            # Mantiene\
      \ el valor retenido durante todo el periodo\n            out[i] = self.held_value\n\
      \n        return len(out)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Sampler', 'blk', [], [('0', 'float', 1), ('1', 'float', 1)], [('0',
      'float', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [336, 368.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    M_p: M_p
    N_bits: N_bits
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, N_bits=4, M_p=1.0):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Quantizer',\n            in_sig=[np.float32],\n\
      \            out_sig=[np.float32]\n        )\n        self.N_bits = N_bits\n\
      \        self.M_p = M_p\n\n    def work(self, input_items, output_items):\n\
      \        in_data = input_items[0]\n        out = output_items[0]\n\n       \
      \ L = 2**self.N_bits\n        delta = (2.0 * self.M_p) / L\n\n        # Limitar\
      \ valor entre -M_p y M_p\n        clipped = np.clip(in_data, -self.M_p, self.M_p)\n\
      \n        # Calcular nivel de cuantizaci\xF3n punto medio\n        indices =\
      \ np.floor((clipped + self.M_p) / delta)\n        indices = np.clip(indices,\
      \ 0, L - 1)\n\n        out[:] = -self.M_p + (indices + 0.5) * delta\n\n    \
      \    return len(out)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Quantizer', 'blk', [('N_bits', '4'), ('M_p', '1.0')], [('0', 'float',
      1)], [('0', 'float', 1)], '', ['M_p', 'N_bits'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [512, 312.0]
    rotation: 0
    state: enabled
